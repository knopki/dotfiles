{% set username = exec(command='whoami') -%}
{% set hostname = read_file(path='/etc/hostname') -%}
[alias]
    a = "add -p"
    bD = "branch -D"
    ba = "branch -a"
    bd = "branch -d"
    bdm = "!git branch --merged | grep -v '*' | xargs -n 1 git branch -d"
    c = "commit"
    co = "checkout"
    cob = "checkout -b"
    d = "difftool"
    dc = "difftool --cached"
    ds = "difftool --staged"
    f = "fetch -p"
    fpush = "push --force-with-lease"
    h1rd = "hard HEAD~1"
    hard = "reset --hard"
    lg = "log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
    p = "push"
    r = "restore"
    rank = "shortlog -sn --no-merges"
    rs = "restore --staged"
    s1ft = "soft HEAD~1"
    soft = "reset --soft"
    st = "status -sb"
    tlog = "log --stat --since='1 Day Ago' --graph --pretty=oneline --abbrev-commit --date=relative"
    undo = "reset --soft HEAD^"

[apply]
    whitespace = "fix"

[branch]
    sort = "-committerdate"

[color]
    ui = "auto"

[color "branch"]
    current = "yellow reverse"
    local = "yellow"
    remote = "green"

[color "diff"]
    frag = "magenta bold"
    meta = "yellow bold"
    new = "green"
    old = "red"

[color "status"]
    added = "yellow"
    changed = "green"
    untracked = "cyan"

[core]
    quotepath = "off"
    whitespace = "space-before-tab,-indent-with-non-tab,trailing-space"

[diff]
    renames = "copies"

[diff "bin"]
    textconv = "hexdump -v -C"

[help]
    autocorrect = "1"

[include]
    path = "local"

[init]
    defaultBranch = "master"

[log]
    abbrevCommit = "true"
    decorate = "short"

[merge]
    conflictstyle = "diff3"
    ff = "only"
    log = "true"

[pull]
    rebase = true

[push]
    default = "current"
    followTags = "true"

[rebase]
    autosquash = "true"

[status]
    showUntrackedFiles = "all"

[transfer]
    fsckobjects = "true"

{% if exec(command='command -v git-lfs >/dev/null 2>&1 && echo yes || echo no') | trim == "yes" %}
[filter "lfs"]
    clean = "git-lfs clean -- %f"
    process = "git-lfs filter-process --skip"
    required = true
    smudge = "git-lfs smudge --skip -- %f"
{% endif %}

{% if exec(command='command -v difftastic >/dev/null 2>&1 && echo yes || echo no') | trim == "yes" %}
[alias]
    # `git diff` with difftastic.
    ddiff = -c diff.external=difft diff

    # `git log` with patches shown with difftastic.
    dlol = -c diff.external=difft log -p --ext-diff

    # Show the most recent commit with difftastic.
    dshow = -c diff.external=difft show --ext-diff

[diff]
    # Set difftastic as the default difftool, so we don't need to specify
    # `-t difftastic` every time.
    tool = difftastic

[difftool "difftastic"]
    # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[difftool]
    # Run the difftool immediately, don't ask 'are you sure' each time.
    prompt = false

[pager]
    # Use a pager if the difftool output is larger than one screenful,
    # consistent with the behaviour of `git diff`.
    difftool = true
{% endif -%}

[user]
    name = "{{ vars?.USER_NAME or username }}"
    email = "{{ vars?.USER_EMAIL or username~'@'~hostname }}"
{%- if vars.GPG_SIGN_KEY is defined %}
    signingKey = "{{ vars.GPG_SIGN_KEY }}"

[commit]
    gpgSign = true

[tag]
    gpgSign = true
{% endif %}

{%- if vars.USER_PUBLIC_NAME is defined and vars.USER_PUBLIC_EMAIL %}
[includeIf "gitdir:~/prj/abs*x/"]
    path = public-identity
{% endif %}

{%- if vars.USER_PUBLIC_NAME is defined and vars.USER_AMP_EMAIL %}
[includeIf "gitdir:~/prj/amp*a/"]
    path = amp-identity
{% endif %}
