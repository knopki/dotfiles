#!/usr/bin/env bash

#
# Choosing between .bashrc, .profile, .bash_profile, etc
#
# - ~/.bash_profile
#   should be super-simple and just load .profile and .bashrc (in that order)
# - ~/.profile
#   has the stuff NOT specifically related to bash,
#   such as environment variables (PATH and friends)
# - ~/.bashrc
#   has anything you'd want at an interactive command line.
#   Command prompt, EDITOR variable, bash aliases
#
# A few other notes:
# - Anything that should be available to graphical applications
#   OR to sh (or bash invoked as sh) MUST be in ~/.profile
# - ~/.bashrc must not output anything
# - Anything that should be available only to login shells should go in ~/.profile
# - Ensure that ~/.bash_login does not exist.

prepend_path() {
	case ":$PATH:" in
	*:"$1":*) ;;
	*) PATH="$1:$PATH" ;;
	esac
}

# Only for interactive bash
case $- in
*i*) ;;
*) return ;;
esac

# Must be a real terminal (helps avoid odd non-tty interactive contexts)
[[ -t 0 && -t 1 ]] || return

#
# Run fish shell
#

__is_devenv_wrapped_bash() {
	# strong signal: env
	[[ -n "${DEVENV_ROOT-}" ]] && return 0

	# strong signal: cmdline contains .devenv rcfile
	# /proc/$$/cmdline is NUL-separated
	local cmdline
	cmdline="$(tr '\0' ' ' </proc/$$/cmdline 2>/dev/null || true)"
	[[ "$cmdline" == *"--rcfile "*".devenv/"* ]] && return 0

	return 1
}

__maybe_exec_fish() {
	# Avoid loops / double-runs
	[[ -n "${__AUTO_FISH_DONE-}" ]] && return 1
	__AUTO_FISH_DONE=1

	# Don't interfere with `bash -c ...`
	[[ -z "${BASH_EXECUTION_STRING-}" ]] || return 1

	# Optional: manual override to stay in bash
	[[ -n "${NO_FISH-}" ]] && return 1

	# Fish must exist
	command -v fish >/dev/null 2>&1 || return 1

	# Parent is fish: normally we skip to avoid loops,
	# but NOT if bash is devenv-wrapped.
	if [[ -r "/proc/$PPID/comm" ]]; then
		local comm
		IFS= read -r comm < "/proc/$PPID/comm" || true
		if [[ "$comm" == fish ]] && ! __is_devenv_wrapped_bash; then
			return 0
		fi
	fi

	# Exec fish (login iff current bash is login)
	if shopt -q login_shell; then
		exec fish --login
	else
		exec fish
	fi
}

# Try to switch early; if it doesn't happen, continue bash init normally.
__maybe_exec_fish

#
# Environment variables
#
prepend_path "$HOME/.local/bin"

export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export EDITOR=${EDITOR:-hx}

# shellcheck source=.config/user-dirs.dirs
source "$XDG_CONFIG_HOME/user-dirs.dirs"

# fzf init
# Install fzf hook if all:
#  - fzf command is present
if command -v fzf 2>/dev/null 1>&2; then
	eval "$(fzf --bash)"
fi

# Atuin init
# Install atuin hook if all:
#  - atuin command is present
#  - atuin is configured
if command -v atuin 2>/dev/null 1>&2 &&
	[[ -f "$XDG_CONFIG_HOME/atuin/config.toml" ]]; then
	eval "$(atuin init bash --disable-up-arrow --disable-ctrl-r)"
fi

# Starship init
# Install starship hook if all:
#  - terminal is not dumb
#  - starship is available
#  - starship config exists
if [[ $TERM != "dumb" ]] &&
	command -v starship 2>/dev/null 1>&2 &&
	[[ -f "$XDG_CONFIG_HOME/starship.toml" ]]; then
	eval "$(starship init bash)"
fi
