#!/usr/bin/env python3
import json
import subprocess
import sys
from typing import Any

# Hook should extract all the following for use as Timewarrior tags:
#   UUID
#   Project
#   Tags
#   Description
#   UDAs

IGNORED_TAGS = ["next", "wip", "respond", "review", "later", "problem", "today"]


try:
    input_stream = sys.stdin.buffer
except AttributeError:
    input_stream = sys.stdin

def extract_tags_from(json_obj: dict[str, Any]):
    # Extract attributes for use as tags.
    tags: list[str] = [json_obj['description']]

    if 'project' in json_obj:
        project_parts: list[str] = json_obj['project'].split(".")
        for i in range(len(project_parts), 0, -1):
            tags.append(str.join(".", project_parts[0:i]))

    if 'tags' in json_obj:
        tags_field: list[str] | str = json_obj['tags']
        tags_tags = tags_field.split(',') if tags_field is str else tags_field
        tags.extend([tag for tag in tags_tags if tag not in IGNORED_TAGS])

    return tags


def extract_annotation_from(json_obj):

    if 'annotations' not in json_obj:
        return '\'\''

    return json_obj['annotations'][0]['description']


def main(old, new):

    start_or_stop = ''

    # Started task.
    if 'start' in new and 'start' not in old:
        start_or_stop = 'start'
        
        # Stop all other active tasks excluding current one
        subprocess.run(["task", f"uuid.not:{new['uuid']}", "+ACTIVE", "stop"])

    # Stopped task.
    elif ('start' not in new or 'end' in new) and 'start' in old:
        start_or_stop = 'stop'

    if start_or_stop:
        tags = extract_tags_from(new)

        subprocess.call(['timew', start_or_stop] + tags + [':yes'])

    # Modifications to task other than start/stop
    elif 'start' in new and 'start' in old:
        old_tags = extract_tags_from(old)
        new_tags = extract_tags_from(new)

        if old_tags != new_tags:
            subprocess.call(['timew', 'untag', '@1'] + old_tags + [':yes'])
            subprocess.call(['timew', 'tag', '@1'] + new_tags + [':yes'])

        old_annotation = extract_annotation_from(old)
        new_annotation = extract_annotation_from(new)

        if old_annotation != new_annotation:
            subprocess.call(['timew', 'annotate', '@1', new_annotation])


if __name__ == "__main__":
    old = json.loads(input_stream.readline().decode("utf-8", errors="replace"))
    new = json.loads(input_stream.readline().decode("utf-8", errors="replace"))
    print(json.dumps(new))
    main(old, new)
