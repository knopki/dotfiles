###

report.next.columns=id,project,priority,due,start.active,entry.age,urgency,description.desc,tags
report.next.labels=ID,Proj,Pri,Due,A,Age,Urg,Description,Tags
report.next.filter=status:pending limit:page -BLOCKED -delegated

report.ready.columns=id,project,priority,due,start.active,entry.age,urgency,description,tags
report.ready.labels=ID,Proj,Pri,Due,A,Age,Urg,Description,Tags

report.triage.description=Personal - To-Do
report.triage.columns=id,priority,start.active,urgency,due,description.desc,tags
report.triage.labels=ID,Pri,A,Urg,Due,Description,Tags
report.triage.filter=( proj: or proj:personal ) ( due.before:tomorrow or due: ) status:pending -WAITING -idea
report.triage.sort=urgency-

report.today.description=Tasks for Today
report.today.columns=id,project,priority,start.active,urgency,due,description.desc,tags
report.today.labels=ID,Proj,Pri,A,Urg,Due,Description,Tags
report.today.filter=status:pending -BLOCKED -review and ( ( proj: and ( ( prio:H and due: ) or due.before:tomorrow or +respond or +today or +next or +inprogress or +yesterday) ) or +daytime )
report.today.sort=urgency-

report.active.description=Active Tasks
report.active.columns=id,description.desc,tags
report.active.labels=ID,Description,Tags
report.active.filter=status:pending +ACTIVE
report.active.sort=urgency-

report.inbox.columns=id,start.age,entry.age,priority,tags,description,urgency
report.inbox.description=Inbox
report.inbox.filter=-PROJECT status:pending limit:page
report.inbox.labels=ID,Active,Age,P,Tag,Description,Urg

report.delegated.columns=id,description,start.age,depends,priority,project,recur,scheduled.countdown,due.relative,until.remaining
report.delegated.laberls=ID,Description,Active,Deps,P,Project,Recur,S,Due,Until
report.delegated.filter=status:pending -BLOCKED +delegated
report.delegated.sort=urgency-
report.delegated.description=Delegated tasks

# tasksh review
uda.reviewed.type=date
uda.reviewed.label=Reviewed
report._reviewed.description=Tasksh review report.  Adjust the filter to your needs.
report._reviewed.columns=uuid
report._reviewed.sort=reviewed+,modified+
report._reviewed.filter=( reviewed.none: or reviewed.before:now-6days ) and ( +PENDING or +WAITING )

# Contexts
context.home=+@home

uda.priority.values=H,M,,L
uda.priority.default=M
priority.default=M


urgency.user.tag.next.coefficient=          15.0 # +next tag
urgency.due.coefficient=                    12.0 # overdue or near due date
# urgency.blocking.coefficient=              0.0 # blocking other tasks
urgency.blocking.coefficient=                8.0 # blocking other tasks
urgency.uda.priority.H.coefficient=          6.0 # high Priority
urgency.uda.priority.M.coefficient=          3.9 # medium Priority
# urgency.uda.priority.L.coefficient=        1.8 # low Priority
urgency.uda.priority.L.coefficient=         -1.8 # low Priority
urgency.scheduled.coefficient=               5.0 # scheduled tasks
urgency.active.coefficient=                  4.0 # already started tasks
urgency.age.coefficient=                     2.0 # coefficient for age
urgency.annotations.coefficient=             0.0 # has annotations
urgency.tags.coefficient=                    1.0 # has tags
urgency.project.coefficient=                 1.0 # assigned to any project
urgency.waiting.coefficient=                -3.0 # waiting task
urgency.blocked.coefficient=                -5.0 # blocked by other tasks

urgency.user.project.tilde.coefficient=      5.0 # assigned to project
urgency.user.project.amperka.coefficient=    2.5 # assigned to project
urgency.user.tag.respond.coefficient=       10.0
urgency.user.tag.review.coefficient=        -5.0
urgency.user.tag.inprogress.coefficient=     2.5
urgency.user.tag.today.coefficient=          2.0
urgency.user.tag.yesterday.coefficient=      3.0
# urgency.user.tag.plane.coefficient=         -2.0
urgency.user.tag.later.coefficient=         -6.0
urgency.user.tag.problem.coefficient=        4.5

