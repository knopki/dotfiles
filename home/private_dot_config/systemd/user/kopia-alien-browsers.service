[Service]
CPUSchedulingPolicy=idle
Environment=KOPIA_CONFIG_PATH=/run/secrets/sk-kopia-repository-config
Environment=KOPIA_CONTENT_LOG_DIR_MAX_AGE=168h
Environment=KOPIA_LOG_DIR_MAX_AGE=168h
EnvironmentFile=/run/secrets/sk-kopia-repo-password-env-file
ExecStart=flock kopia-service.lock kopia snapshot create %E/BraveSoftware/Brave-Browser/Default '%E/BraveSoftware/Brave-Browser/Profile 1' '%E/BraveSoftware/Brave-Browser/Profile 2' '%E/BraveSoftware/Brave-Browser/Profile 3' '%E/BraveSoftware/Brave-Browser/Profile 4'
IOSchedulingClass=idle
Restart=on-failure
RestartSec=1m
Type=oneshot
WorkingDirectory=/run/user/%U

[Unit]
After=sops-nix.service
Description=Kopia sync - alien-browsers
StartLimitIntervalSec=0
