{
  "skills": [],
  "fileTypeSkills": {
    ".js": ["modern-javascript-patterns"],
    ".tf": ["terraform-configuration", "terraform-modules", "terraform-state"],
    ".py": [
      "pythin-type-system",
      "python-async-patterns",
      "python-data-classes",
      "python-performance-optimizations"
    ],
    "pyproject.toml,requirements.txt": [
      "python-packaging",
      "uv-package-manager"
    ],
    ".ts,.tsx": [
      "typescript-type-system",
      "typescipt-advanced-types",
      "typescript-utility-type",
      "typescript-async-patterns"
    ],
    ".sh": ["bash-defensive-patterns"]
  },
  "agentSkills": {
    "smart": [],
    "oracle": [
      "architecture-design",
      "architecture-patterns",
      "architecture-decision-records"
    ],
    "codebase-explorer": [],
    "librarian": [],
    "implementer": [],
    "ux": [],
    "debugger": ["debuging-strategies"],
    "tester": [],
    "reviewer": ["code-review-excellence"],
    "document-writer": []
  },
  "pathPatterns": {
    "src/api/**": [],
    "src/components/**": []
  },
  "contentTriggers": {
    "architecture": [
      "architecture-design",
      "architecture-patterns",
      "architecture-decision-records"
    ],
    "authentication": ["auth-implementation-patterns"],
    "api": ["backend-api-standards"],
    "database": ["backend-models-standards", "database-migration"],
    "debug": ["debuging-strategies"],
    "fastapi": [
      "fastapi-async-patterns",
      "fastapi-dependency-injection",
      "fastapi-templates",
      "fastapi-validation"
    ],
    "microservices": ["microservices-patterns"],
    "oop": [
      "oop-encapsulation",
      "oop-inheritance-composition",
      "oop-polymorphism"
    ],
    "pytest": ["pytest-advanced", "pytest-fixtures", "pytest-plugins"]
  },
  "groups": {
    "frontend": [],
    "backend": []
  },
  "conditionalSkills": [
    { "skill": "react", "if": { "packageHasDependency": "react" } },
    { "skill": "prisma", "if": { "fileExists": "prisma/schema.prisma" } }
  ],
  "skillSettings": {
    "large-skill": { "useSummary": true },
    "critical-skill": { "useSummary": false }
  },
  "injectionMethod": "systemPrompt",
  "maxTokens": 10000,
  "useSummaries": false,
  "useMinification": "aggressive",
  "showToasts": true,
  "enableTools": false,
  "analytics": true,
  "persistAfterCompaction": true,
  "debug": false
}
