{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "@simonwjackson/opencode-direnv@v2025.1211.9",
    "@tarquinen/opencode-dcp@1.0.2",
  ],

  "experimental": {
    "chatMaxRetries": 10,
    "primary_tools": ["prune"],
  },

  "instructions": [
    "CONTRIBUTING.md",
    "CLAUDE.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "AGENTS.override.md",
  ],

  "mcp": {
    // TODO: Anytype
    // TODO: web search via https://github.com/deedy5/ddgs
    // TODO: https://ankimcp.ai/
    // TODO: Chrome DevTools MCP
    // TODO: https://github.com/chigwell/telegram-mcp
    // TODO: https://github.com/zilliztech/claude-context
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/sse",
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
  },

  "permission": {
    "bash": {
      "cut *": "allow",
      "diff *": "allow",
      "date *": "allow",
      "du *": "allow",
      "file *": "allow",
      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "find * -fls*": "ask",
      "find * -fprint*": "allow",
      "find * -fprintf*": "allow",
      "find * -ok*": "ask",
      "find *": "allow",
      "git branch -v": "allow",
      "git branch": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "grep *": "allow",
      "head *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "more *": "allow",
      "notify-send *": "allow",
      "pwd *": "allow",
      "pwd": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "python -m compileall *": "allow",
      "python -m py_compile *": "allow",
      "python -m pytest *": "allow",
      "rg *": "allow",
      "ruff *": "allow",
      "sort *": "allow",
      "sort --output=*": "ask",
      "sort -o *": "ask",
      "stat *": "allow",
      "tail *": "allow",
      "tree *": "allow",
      "tree -o *": "ask",
      "uniq *": "allow",
      "uv run ruff *": "allow",
      "wc *": "allow",
      "which*": "allow",
      "*": "ask",
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    // NOTE: run opencode only inside a bubblewrap/VM
    "external_directory": "ask", // YOLO
    "skill": {
      "*": "deny",
      "skill-creator": "deny", // skill is broken now
      "professional-honesty": "allow",
    },
  },

  "tools": {
    "context7*": false,
    "deepwiki*": false,
    "grep_app*": false,
  },

  "provider": {
    "opencode": {
      "whitelist": ["grok-code", "glm-4.7-free", "big-pickle", "gpt-5-nano"],
    },
    "openrouter": {
      "whitelist": [
        "anthropic/claude-sonnet-4.5",
        "anthropic/claude-haiku-4.5",

        "google/gemini-3-flash-preview",
        "google/gemini-3-pro-preview",

        "kwaipilot/kat-coder-pro:free",

        "minimax/minimax-m2.1",

        "mistralai/devstral-2512:free",
        "mistralai/mistral-medium-3.1",

        "moonshotai/kimi-k2-0905",

        "openai/gpt-5.2",
        "openai/gpt-5.1-codex",
        "openai/gpt-oss-120b",

        "qwen/qwen3-coder",

        "x-ai/grok-code-fast-1",

        "xiaomi/mimo-v2-flash:free",
      ],
      "models": {
        "xiaomi/mimo-v2-flash:free": {
          "options": {
            "reasoningEffort": "none",
          },
        },
      },
    },
    "zai-coding-plan": {
      "whitelist": ["glm-4.7", "glm-4.6"],
    },
  },

  // default model if not set by agent
  "model": "opencode/big-pickle",
  // small and cheap model used for title generation
  // "small_model": "opencode/big-pickle",

  "agent": {
    // primary default build agent
    "build": {
      "tools": { "skill": true },
      "permission": {
        "skill": { "continuity-ledger": "allow" },
      },
    },

    // primary default planning agent (save as build but with plan message)
    "plan": {
      "tools": {
        "edit": false,
        "multiedit": false,
        "write": false,
      },
    },

    // General-purpose sub-agent and fast for researching complex questions and executing multi-step tasks
    // Default tools without access to todos
    "general": {
      "permission": {
        "skill": { "continuity-ledger": "allow" },
      },
      "tools": {},
    },

    // Fast subagent specialized for exploring codebases
    // Defaults tools without access to todos, edit, write
    "explore": {
      // prefer free/cheap and fast model
      "model": "opencode/big-pickle",
      "tools": {
        "edit": false,
        "multiedit": false,
        "write": false,
      },
    },
  },
}
