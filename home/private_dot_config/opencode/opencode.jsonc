{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "@simonwjackson/opencode-direnv@v2025.1211.9",
    "@tarquinen/opencode-dcp@2.1.3",
    "opencode-gemini-auth@v1.3.10",
    "@slkiser/opencode-quota@2.0.0",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "opencode-plugin-preload-skills@1.8.0",
  ],

  "experimental": {
    "primary_tools": ["prune"],
    "chatMaxRetries": 100,
  },

  "instructions": [
    "AGENTS.md",
    "AGENTS.local.md",
    "AGENTS.override.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    ".opencode/CONTINUITY.md",
  ],

  "mcp": {
    // TODO: Chrome DevTools MCP
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
  },

  "permission": {
    "bash": {
      "*": "ask",
      "cut *": "allow",
      "diff *": "allow",
      "date *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "find * -fls*": "ask",
      "find * -fprint*": "allow",
      "find * -fprintf*": "allow",
      "find * -ok*": "ask",
      "find *": "allow",
      "git branch -v": "allow",
      "git branch": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "git *": "ask",
      "grep *": "allow",
      "head *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "mkdir -p openspec/*": "allow",
      "more *": "allow",
      "mv openspec/* openspec/*": "allow",
      "notify-send *": "allow",
      "openspec *": "allow",
      "pwd *": "allow",
      "pwd": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "python -m compileall *": "allow",
      "python -m py_compile *": "allow",
      "python -m pytest *": "allow",
      "pyright*": "allow",
      "rg *": "allow",
      "ruff *": "allow",
      "tail *": "allow",
      "tree *": "allow",
      "tree -o *": "ask",
      "uniq *": "allow",
      "uv run pyright*": "allow",
      "uv run pytest": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow",
      "wc *": "allow",
      "which*": "allow",
    },
    "edit": "deny",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    // needs OPENCODE_EXPERIMENTAL_LSP_TOOL=true
    "lsp": "deny",
    "webfetch": "deny",
    // needs OPENCODE_ENABLE_EXA=1
    "websearch": "deny",
    "question": "deny",
    "skill": {
      "*": "deny",
      "skill-creator": "deny", // skill is broken now
      "professional-honesty": "allow",
    },
    "context7_*": "deny",
    "deepwiki_*": "deny",
    "grep_app_*": "deny",
    "task": "deny",
    "doom_loop": "ask",
    // NOTE: run opencode only inside a bubblewrap/VM
    "external_directory": "ask", // YOLO
  },

  "provider": {
    "google": {
      "options": {
        // "projectId": "centered-song-135214",
        "projectId": "gen-lang-client-0017400975",
      },
    },
    "opencode": {
      "whitelist": ["big-pickle", "gpt-5-nano", "glm-5-free"],
    },
    "openrouter": {
      "whitelist": [
        "google/gemini-3-flash-preview",
        "google/gemini-3-pro-preview",

        "minimax/minimax-m2.5",

        "mistralai/mistral-medium-3.1",
        "mistralai/mistral-large-2512",

        "moonshotai/kimi-k2.5",

        "qwen/qwen3.5-397b-a17b",
        "qwen/qwen3.5-plus-02-15",

        "z-ai/glm-5",
      ],
    },
    "zai-coding-plan": {
      "whitelist": ["glm-4.7", "glm-4.6", "glm-5"],
    },
  },

  // default model if not set by agent
  "model": "opencode/big-pickle",
  // small and cheap model used for title generation
  "small_model": "opencode/gpt-5-nano",

  "agent": {
    // primary default build agent
    "build": {
      "permission": {
        "edit": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "lsp": "allow",
        "webfetch": "ask",
        "websearch": "ask",
        "question": "allow",
        "skill": { "continuity-ledger": "allow" },
        "context7_*": "ask",
        "deepwiki_*": "ask",
        "grep_app_*": "ask",
        "task": "allow",
      },
    },

    // primary default planning agent (save as build but with plan message)
    "plan": {
      "permission": {
        "bash": "ask",
        "edit": {
          "*": "deny",
          ".opencode/CONTINUITY.md": "allow",
        },
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "lsp": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "skill": { "continuity-ledger": "allow" },
        "context7_*": "allow",
        "deepwiki_*": "allow",
        "grep_app_*": "allow",
        "task": "allow",
      },
    },

    // General-purpose sub-agent and fast for researching complex questions and executing multi-step tasks
    "general": {
      "permission": {
        "edit": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "todowrite": "deny",
        "todoread": "deny",
        "lsp": "allow",
        "webfetch": "deny",
        "websearch": "allow",
        "question": "deny",
        "skill": { "continuity-ledger": "allow" },
        "context7_*": "allow",
        "deepwiki_*": "allow",
        "grep_app_*": "allow",
        "task": "allow",
      },
    },

    // Fast subagent specialized for exploring codebases
    "explore": {
      // prefer free/cheap and fast model
      "model": "opencode/big-pickle",
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/CONTINUITY.md": "allow",
        },
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "todowrite": "deny",
        "todoread": "deny",
        "lsp": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "skill": { "continuity-ledger": "allow" },
        "context7_*": "deny",
        "deepwiki_*": "deny",
        "grep_app_*": "deny",
        "task": "deny",
      },
    },
  },
}
