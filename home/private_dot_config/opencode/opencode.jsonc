{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,

  "plugin": [
    // "opencode-omniroute-auth@1.1.0",
    "opencode-handoff@0.5.0",
    // "@tarquinen/opencode-dcp@3.1.9",
    // "opencode-pty@0.3.2",
    "@franlol/opencode-md-table-formatter@0.0.6",
    // "opencode-plugin-preload-skills@1.8.0"
    "opencode-runtime-fallback@0.2.4",
  ],

  "instructions": [
    "AGENTS.md",
    "AGENTS.local.md",
    "AGENTS.override.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
  ],

  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": ["gitnexus", "mcp"],
    },
    // TODO: Chrome DevTools MCP
  },

  "tools": {
    "gitnexus_*": false,
  },

  "permission": {
    "bash": {
      "*": "ask",
      "cut *": "allow",
      "diff *": "allow",
      "date *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find *": "allow",
      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "find * -fls*": "ask",
      "find * -fprint*": "allow",
      "find * -fprintf*": "allow",
      "find * -ok*": "ask",
      "git *": "ask",
      "git branch*": "ask",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "grep *": "allow",
      "head *": "allow",
      "less *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "more *": "allow",
      "notify-send *": "allow",
      "openspec *": "allow",
      "pwd*": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "python -m compileall *": "allow",
      "python -m py_compile *": "allow",
      "python -m pytest *": "allow",
      "pyright*": "allow",
      "rg *": "allow",
      "ruff *": "allow",
      "tail *": "allow",
      "tree *": "allow",
      "tree -o *": "ask",
      "uniq *": "allow",
      "uv run pyright*": "allow",
      "uv run pytest": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow",
      "wc *": "allow",
      "which*": "allow",
      "./scripts/grep-app-mcp call-tool searchGitHu *": "allow",
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".envrc": "deny",
    },
    "edit": "deny",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    // needs OPENCODE_EXPERIMENTAL_LSP_TOOL=true
    "lsp": "deny",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "deny",
    // needs OPENCODE_ENABLE_EXA=1
    "websearch": "deny",
    "question": "deny",
    // whitelist only
    "skill": "deny",
    // no subagents
    "task": "deny",
  },

  "disabled_providers": ["anthropic", "gemini", "openai-codex"],
  "provider": {
    "minimax": {
      "options": {
        "baseURL": "http://localhost:8317/v1",
      },
      "whitelist": ["MiniMax-M2.5", "MiniMax-M2.7"],
    },
    "moonshotai": {
      "options": {
        "baseURL": "http://localhost:8317/v1",
      },
      "whitelist": ["kimi-k2.6"],
    },
    // "omniroute": {
    //   "options": {
    //     "baseURL": "http://localhost:20128/v1",
    //     "refreshOnList": false,
    //     "modelCacheTtl": 300000,
    //     "modelsDev": {
    //       "providerAliases": {
    //         "cx": "openai",
    //         "codex": "openai",
    //         "gemini": "google",
    //         "opencode-zen": "opencode",
    //         "glm": "zai-coding-plan",
    //       },
    //     },
    //   },
    // },
    "openai": {
      "options": {
        "baseURL": "http://localhost:8317/v1",
      },
      "whitelist": ["gpt-5.4-pro", "gpt-5.4", "gpt-5.4-mini", "gpt-5.5"],
    },
    "openrouter": {
      "options": {
        "baseURL": "http://localhost:8317/v1",
      },
      "whitelist": [
        "anthropic/claude-opus-4.7",
        "openai/gpt-oss-120b",
        "openai/gpt-oss-20b",
        "openrouter/free",
        "google/gemini-2.5-flash",
        "google/gemini-3-flash-preview",
        "google/gemini-3.1-pro-preview",
        "google/gemini-3.1-flash-lite-preview",
        "qwen/qwen3.6-plus",
      ],
    },
    "zai": {
      "options": {
        "baseURL": "http://localhost:8317/v1",
      },
      "whitelist": ["glm-5.1", "glm-5-turbo", "glm-4.7"],
    },
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
  },

  // default model if not set by agent
  "model": "openai/gpt-5.5",
  // small and cheap model used for title generation
  "small_model": "openrouter/google/gemini-2.5-flash",
  // "small_model": "minimax/MiniMax-M2.5",

  "default_agent": "plan",
  "agent": {
    // primary default build agent
    "build": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "openai/gpt-5.4",
        "moonshotai/kimi-k2.6",
        "zai/glm-5.1",
      ],
      "permission": {
        "edit": "allow",
        "apply_patch": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "webfetch": "ask",
        "websearch": "ask",
        "question": "allow",
        "skill": {
          "agent-browser": "allow",
          "changelog-automation": "allow",
          "codebase-to-course": "allow",
          "doc-coauthoring": "allow",
          "find-docs": "allow",
          "gitnexus-*": "allow",
          "grep-app-cli": "allow",
          "ui-ux-pro-max": "allow",
        },
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
          "build": "allow",
        },
      },
      "tools": {
        "gitnexus_*": true,
      },
    },

    // primary default planning agent (save as build but with plan message)
    "plan": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "openai/gpt-5.4",
        "moonshotai/kimi-k2.6",
        "zai/glm-5.1",
      ],
      "permission": {
        "bash": "ask",
        "edit": "deny",
        "apply_patch": "deny",
        "lsp": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "webfetch": "ask",
        "websearch": "allow",
        "question": "allow",
        "skill": {
          "agent-browser": "allow",
          "changelog-automation": "allow",
          "codebase-to-course": "allow",
          "doc-coauthoring": "allow",
          "find-docs": "allow",
          "gitnexus-*": "allow",
          "grep-app-cli": "allow",
          "ui-ux-pro-max": "allow",
        },
        "task": {
          "*": "deny",
          "explore": "allow",
        },
      },
      "tools": {
        "pty_*": false,
        "gitnexus_*": true,
      },
    },

    // General-purpose sub-agent and fast for researching complex questions and executing multi-step tasks
    "general": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": ["minimax/MiniMax-M2.7", "zai/glm-4.7"],
      "permission": {
        "edit": "allow",
        "lsp": "allow",
        "todowrite": "deny",
        "todoread": "deny",
        "webfetch": "deny",
        "websearch": "allow",
        "question": "deny",
        "skill": {
          "find-docs": "allow",
          "gitnexus-*": "allow",
          "grep-app-cli": "allow",
        },
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
        },
      },
      "tools": {
        "gitnexus_*": true,
      },
    },

    // Fast subagent specialized for exploring codebases
    "explore": {
      // prefer free/cheap and fast model
      "model": "openai/gpt-5.4-mini",
      "fallback_models": ["minimax/MiniMax-M2.7", "zai/glm-4.7"],
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "todowrite": "deny",
        "todoread": "deny",
        "lsp": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "skill": {
          "find-docs": "allow",
          "gitnexus-exploring": "allow",
          "gitnexus-impact-analysis": "allow",
        },
        "task": "deny",
      },
      "tools": {
        "pty_*": false,
        "gitnexus_*": true,
      },
    },
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".devenv/*",
      ".direnv/*",
    ],
  },

  "formatter": {},

  "lsp": {},
}
