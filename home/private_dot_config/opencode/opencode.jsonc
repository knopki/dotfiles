{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    "opencode-runtime-fallback@0.2.4",
    [
      "opencode-auto-resume@1.0.12",
      {
        "chunkTimeoutMs": 45000,
        "gracePeriodMs": 3000,
        "maxRetries": 10,
      },
    ],
    "opencode-handoff-plus@1.0.10",
    "@tarquinen/opencode-dcp@3.1.12",
    "@franlol/opencode-md-table-formatter@0.0.6",
  ],
  "instructions": [
    "AGENTS.md",
    "AGENTS.local.md",
    "AGENTS.override.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
    },
  },
  "tools": {
    "codegraph_*": false,
  },
  "permission": {
    "bash": {
      "*": "allow", // use only inside the sandbox!
      "docker *--privileged*": "deny",
      "podman *--privileged*": "deny",
      "pip install*": "deny",
    },
    "read": {
      "*": "allow",
      "/dev/stdin": "deny",
      ".env": "deny",
      ".env.*": "deny",
      ".envrc": "deny",
    },
    "skill": {
      "*": "deny",
      "nono-sandbox": "allow",
    },
    "task": "deny",
    "doom_loop": "deny",
    "external_directory": "allow", // use only inside the sandbox!
    "write_handoff_file": "deny",
    "read_session": "deny",
  },
  "disabled_providers": ["anthropic", "gemini", "openai-codex"],
  "provider": {
    "deepseek": {
      "blacklist": ["deepseek-chat", "deepseek-reasoner"],
    },
    "ollama-cloud": {
      "blacklist": [
        "cogito-2.1:671b",
        "deepseek-v3.1:671b",
        "deepseek-v3.2",
        "devstral-2:123b",
        "devstral-small-2:24b",
        "gemma3:12b",
        "gemma3:27b",
        "gemma3:4b",
        "glm-4.6",
        "glm-5",
        "kimi-k2-thinking",
        "kimi-k2:1t",
        "kimi-k2.5",
        "minimax-m2",
        "minimax-m2.1",
        "minimax-m2.5",
        "ministral-3:14b",
        "ministral-3:3b",
        "ministral-3:8b",
        "mistral-large-3:675b",
        "nemotron-3-nano:30b",
        "nemotron-3-super",
        "qwen3-coder-next",
        "qwen3-coder:480b",
        "qwen3-next",
        "qwen3-vl:235b",
        "qwen3-vl:235b-instruct",
        "qwen3.5:397b",
        "rnj-1:8b",
      ],
    },
    "opencode-go": {
      "blacklist": ["glm-5", "glm-5.1", "kimi-k2.5"],
    },
    "openrouter": {
      "whitelist": ["openrouter/free"],
    },
    "zhipuai-coding-plan": {
      "blacklist": ["glm-4.5-air", "glm-5v-turbo", "glm-5", "glm-5.1"],
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4,
    "preserve_recent_tokens": 25000,
    "reserved": 30000,
  },
  "model": "zhipuai-coding-plan/glm-5.2",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "k-composer",
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".devenv/*",
      ".direnv/*",
    ],
  },
  "formatter": {},
  "lsp": {
    "pyright": {
      "disabled": true,
    },
    "zuban": {
      "command": ["uv", "run", "zuban", "server"],
      "extensions": [".py"],
    },
  },
}
