  // default model if not set by agent
  "model": "opencode/big-pickle",
  // small and cheap model used for title generation
  // "small_model": "opencode/gpt-5-nano",

  "agent": {
    // primary default build agent
    "build": {
      "permission": {
        "edit": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "lsp": "allow",
        "webfetch": "ask",
        "websearch": "ask",
        "question": "allow",
        "skill": { "continuity-ledger": "allow" },
        "context7_*": "ask",
        "deepwiki_*": "ask",
        "grep_app_*": "ask",
        "task": "allow",
      },
    },

    // primary default planning agent (save as build but with plan message)
    "plan": {
      "permission": {
        "bash": "ask",
        "edit": {
          "*": "deny",
          ".opencode/CONTINUITY.md": "allow",
        },
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "lsp": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "skill": { "continuity-ledger": "allow" },
        "context7_*": "allow",
        "deepwiki_*": "allow",
        "grep_app_*": "allow",
        "task": "allow",
      },
    },

    // General-purpose sub-agent and fast for researching complex questions and executing multi-step tasks
    "general": {
      "permission": {
        "edit": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "todowrite": "deny",
        "todoread": "deny",
        "lsp": "allow",
        "webfetch": "deny",
        "websearch": "allow",
        "question": "deny",
        "skill": { "continuity-ledger": "allow" },
        "context7_*": "allow",
        "deepwiki_*": "allow",
        "grep_app_*": "allow",
        "task": "allow",
      },
    },

    // Fast subagent specialized for exploring codebases
    "explore": {
      // prefer free/cheap and fast model
      "model": "opencode/big-pickle",
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/CONTINUITY.md": "allow",
        },
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "todowrite": "deny",
        "todoread": "deny",
        "lsp": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "skill": { "continuity-ledger": "allow" },
        "context7_*": "deny",
        "deepwiki_*": "deny",
        "grep_app_*": "deny",
        "task": "deny",
      },
    },
  },
