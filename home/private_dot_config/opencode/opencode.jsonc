{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    // "@simonwjackson/opencode-direnv@v2025.1211.9",
    "@tarquinen/opencode-dcp@2.1.7",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "opencode-plugin-preload-skills@1.8.0",
  ],

  "experimental": {
    "primary_tools": ["prune"],
    "chatMaxRetries": 100,
  },

  "instructions": [
    "AGENTS.md",
    "AGENTS.local.md",
    "AGENTS.override.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    ".opencode/CONTINUITY.md",
  ],

  "mcp": {
    // TODO: Chrome DevTools MCP
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
  },

  "permission": {
    "bash": {
      "*": "ask",
      "cut *": "allow",
      "diff *": "allow",
      "date *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "find * -fls*": "ask",
      "find * -fprint*": "allow",
      "find * -fprintf*": "allow",
      "find * -ok*": "ask",
      "find *": "allow",
      "git branch -v": "allow",
      "git branch": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "git *": "ask",
      "grep *": "allow",
      "head *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "mkdir -p openspec/*": "allow",
      "more *": "allow",
      "mv openspec/* openspec/*": "allow",
      "notify-send *": "allow",
      "openspec *": "allow",
      "pwd *": "allow",
      "pwd": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "python -m compileall *": "allow",
      "python -m py_compile *": "allow",
      "python -m pytest *": "allow",
      "pyright*": "allow",
      "rg *": "allow",
      "ruff *": "allow",
      "tail *": "allow",
      "tree *": "allow",
      "tree -o *": "ask",
      "uniq *": "allow",
      "uv run pyright*": "allow",
      "uv run pytest": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow",
      "wc *": "allow",
      "which*": "allow",
    },
    "edit": "deny",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    // needs OPENCODE_EXPERIMENTAL_LSP_TOOL=true
    "lsp": "deny",
    "webfetch": "deny",
    // needs OPENCODE_ENABLE_EXA=1
    "websearch": "deny",
    "question": "deny",
    "skill": {
      "*": "deny",
      "skill-creator": "deny", // skill is broken now
      "professional-honesty": "allow",
    },
    "context7_*": "deny",
    "deepwiki_*": "deny",
    "grep_app_*": "deny",
    "task": "deny",
    "doom_loop": "ask",
    // NOTE: run opencode only inside a bubblewrap/VM
    "external_directory": "ask", // YOLO
  },

  "provider": {
    "cliproxyapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxyAPI",
      "options": {
        "baseURL": "http://localhost:8317/v1",
      },
      "models": {
        "anthropic/claude-opus-4.6": {          
