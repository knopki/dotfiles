{
  "extends": [
    "always-further/opencode",
    "safe-env-vars",
    "helix",
    "node-dev",
    "python-dev",
    "podman",
    "git"
  ],
  "meta": {
    "name": "oc"
  },
  "groups": {
    "include": []
  },
  "filesystem": {
    "allow": [
      "$XDG_DATA_HOME/npm",
      "$XDG_DATA_HOME/rtk",
      "$XDG_STATE_HOME/opencode",
      "$HOME/.context7",
      "$HOME/.npm"
    ],
    "read": ["$XDG_CONFIG_HOME/git", "$XDG_CONFIG_HOME/openspec"],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "network_profile": null
  },
  "undo": {
    "exclude_patterns": [".venv"],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  },
  "allow_launch_services": true
}
