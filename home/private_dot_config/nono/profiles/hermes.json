{
  "extends": [
    "default",
    "oc",
    "node-dev",
    "python-dev",
    "always-further/hermes",
    "safe-env-vars",
    "taskwarrior",
    "timewarrior",
    "khal",
    "khard",
    "podman",
    "gui",
    "git"
  ],
  "meta": {
    "name": "hermes"
  },
  "groups": {
    "include": []
  },
  "filesystem": {
    "allow": [
      "$XDG_CACHE_HOME/huggingface",
      "$XDG_DATA_HOME/npm",
      "$XDG_DATA_HOME/rtk",
      "$XDG_RUNTIME_DIR/agent-browser",
      "$XDG_STATE_HOME/hermes",
      "$HOME/.agent-browser",
      "$HOME/.context7"
    ],
    "allow_file": [
      "$XDG_RUNTIME_DIR/pipewire-0",
      "$XDG_CONFIG_HOME/pulse/cookie"
    ],
    "read": [
      "$XDG_CONFIG_HOME/nono/profiles",
      "$XDG_CONFIG_HOME/git",
      "$HOME/.agents"
    ],
    "read_file": []
  },
  "network": {
    "block": false,
    "network_profile": null
  },
  "open_urls": {
    "allow_localhost": true
  },
  "undo": {
    "exclude_patterns": [".venv"]
  }
}
