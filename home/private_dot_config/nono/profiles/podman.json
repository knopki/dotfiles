{
  "extends": null,
  "meta": {
    "name": "podman",
    "version": "",
    "description": null,
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": ["docker", "podman"],
    "deny": []
  },
  "filesystem": {
    "allow": [
      "$XDG_DATA_HOME/containers",
      "$XDG_RUNTIME_DIR/libpod",
      "/dev/shm",
      "/tmp/podman-run-*"
    ],
    "read": [
      "$XDG_CONFIG_HOME/containers",
      "/etc/containers",
      "/usr/share/containers",
      "/var/log/journal",
      "/run/wrappers"
    ],
    "write": [],
    "allow_file": [],
    "read_file": [
      "/etc/ld-nix.so.preload",
      "/etc/subgid",
      "/etc/subuid",
      "/proc/sys/kernel/random/boot_id"
    ],
    "write_file": [],
    "unix_socket": ["/run/docker.sock", "/run/podman/podman.sock"]
  },
  "linux": {
    "af_unix_mediation": null
  },
  "env_credentials": {},
  "environment": {
    "allow_vars": ["CONTAINER_HOST", "DOCKER_HOST"]
  },
  "interactive": false
}
