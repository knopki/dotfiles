#!/usr/bin/env bash

export RCLONE_BWLIMIT=10M
export RCLONE_CONFIG=/run/secrets/restic-backupman-rclone-config
export RESTIC_PASSWORD_FILE=/run/secrets/restic-backupman-user-data-repo-password
export RESTIC_REPOSITORY=rclone:backupman:/backups/restic-user-data
export RESTIC_PACK_SIZE=128

exec restic "$@"


