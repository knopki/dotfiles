Host *
  HostkeyAlgorithms +ssh-rsa
  PubkeyAcceptedKeyTypes +ssh-rsa

  ServerAliveCountMax 10
  ServerAliveInterval 10

  ForwardAgent yes
  AddKeysToAgent yes

  ControlPath ~/.ssh/connections/%r@%n:%p

Host * !localhost
  ControlMaster auto
  ControlPersist 2h

Host *.onion
  ProxyCommand socat - SOCKS4A:localhost:%h:%p,socksport=9050

Host localhost
  Compression no
  ControlMaster no
